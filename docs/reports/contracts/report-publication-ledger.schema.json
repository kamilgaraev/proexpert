{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:most:reporting:report-publication-ledger:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "events", "schema_version"],
  "properties": {
    "artifact_id": {"const": "report_publication_ledger"},
    "events": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "event_type", "lock", "lock_digest"],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^reports:definition:[a-z][a-z0-9_]{2,63}:published:[a-f0-9]{64}$"
          },
          "event_type": {"const": "definition_published"},
          "lock": {"$ref": "#/$defs/lock"},
          "lock_digest": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "schema_version": {"const": "1.0.0"}
  },
  "$defs": {
    "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "candidate_manifest_hash",
        "code",
        "conformance_hash",
        "definition_hash",
        "previous_manifest_hash",
        "published_at",
        "published_manifest_hash",
        "release_sha",
        "schema_version"
      ],
      "properties": {
        "artifact_id": {"const": "report_publication_lock"},
        "candidate_manifest_hash": {"$ref": "#/$defs/sha256"},
        "code": {"$ref": "#/$defs/code"},
        "conformance_hash": {"$ref": "#/$defs/sha256"},
        "definition_hash": {"$ref": "#/$defs/sha256"},
        "previous_manifest_hash": {"$ref": "#/$defs/sha256"},
        "published_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "published_manifest_hash": {"$ref": "#/$defs/sha256"},
        "release_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "schema_version": {"const": "1.0.0"}
      }
    }
  }
}
