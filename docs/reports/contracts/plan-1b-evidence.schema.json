{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:most:reporting:plan-1b-evidence:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "status",
    "generated_at",
    "plan_1a_reference",
    "repository_revision",
    "gates",
    "ownership",
    "performance_measurements",
    "unresolved_risks",
    "handoff"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "plan_id": {
      "const": "1b"
    },
    "status": {
      "const": "passed"
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "plan_1a_reference": {
      "$ref": "#/$defs/planOneAReference"
    },
    "repository_revision": {
      "$ref": "#/$defs/sha1"
    },
    "gates": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28,
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "ownership": {
      "$ref": "#/$defs/ownership"
    },
    "performance_measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/performanceMeasurement"
      }
    },
    "unresolved_risks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "handoff": {
      "$ref": "#/$defs/handoff"
    }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "planOneAReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lock_sha256",
        "evidence_sha256",
        "generated_at",
        "status"
      ],
      "properties": {
        "lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "generated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "status": {
          "const": "passed"
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "command",
        "result",
        "duration_ms",
        "artifacts"
      ],
      "properties": {
        "id": {
          "enum": [
            "plan1a_handoff",
            "ownership_boundary",
            "run_state_machine",
            "run_idempotency",
            "snapshot_identity",
            "snapshot_seal_trust",
            "typed_data_classification",
            "rows_cursor_drill_parity",
            "row_stream_shape",
            "export_state_machine",
            "export_idempotency",
            "dispatch_outbox_atomicity",
            "dispatch_lease_recovery",
            "dispatch_dead_letter",
            "audit_outbox_delivery",
            "current_async_authorization",
            "execution_attempt_leases",
            "renderer_parity",
            "pdf_renderer_budget",
            "streaming_budget",
            "file_service_call_graph",
            "s3_version_race",
            "audit_fail_closed",
            "retention_exact_version",
            "action_bindings",
            "error_retryability",
            "run_export_observability",
            "static_analysis"
          ]
        },
        "status": {
          "const": "passed"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "$ref": "#/$defs/gateResult"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifactDigest"
          }
        }
      }
    },
    "gateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_code",
        "tests",
        "assertions"
      ],
      "properties": {
        "exit_code": {
          "const": 0
        },
        "tests": {
          "type": "integer",
          "minimum": 0
        },
        "assertions": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifactDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_1a_symbols",
        "plan_1b_symbols",
        "external_plan_owners"
      ],
      "properties": {
        "plan_1a_symbols": {
          "$ref": "#/$defs/symbols"
        },
        "plan_1b_symbols": {
          "$ref": "#/$defs/symbols"
        },
        "external_plan_owners": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "plan_1c_publication_registry",
              "plan_2_candidate_provider_bindings",
              "plan_3_candidate_provider_bindings",
              "plan_4_evidence_verification_rollout"
            ]
          }
        }
      }
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      }
    },
    "performanceMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "value",
        "unit",
        "limit",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "enum": [
            "rows",
            "bytes",
            "milliseconds"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "const": "passed"
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plans_2_and_3",
        "plan_1c",
        "plan_4",
        "artifact_path",
        "digest_algorithm"
      ],
      "properties": {
        "plans_2_and_3": {
          "const": "plan_1a_provider_ports_candidate_bindings_only"
        },
        "plan_1c": {
          "const": "published_registry_map_and_all_publication_transitions"
        },
        "plan_4": {
          "const": "evidence_verification_and_deployment_rollout_only"
        },
        "artifact_path": {
          "const": "build/reports/plan-1b-completion.json"
        },
        "digest_algorithm": {
          "const": "sha256"
        }
      }
    }
  }
}
