{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://most.local/schemas/report-publication-proof.v1.schema.json",
    "title": "ReportPublicationProof v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "code",
        "candidate_manifest_sha256",
        "candidate_definition_sha256",
        "binding_sha256",
        "contract_version",
        "versions",
        "semantic_fingerprints",
        "fixture_sha256",
        "conformance_evidence_sha256",
        "source",
        "formula",
        "components",
        "permissions",
        "export_contracts",
        "drill_down_contract",
        "ci",
        "release"
    ],
    "properties": {
        "code": {"$ref": "#/$defs/reportCode"},
        "candidate_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_definition_sha256": {"$ref": "#/$defs/sha256"},
        "binding_sha256": {"$ref": "#/$defs/sha256"},
        "contract_version": {"$ref": "#/$defs/semver"},
        "versions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_schema", "formula", "contract", "renderer"],
            "properties": {
                "source_schema": {"$ref": "#/$defs/semver"},
                "formula": {"$ref": "#/$defs/semver"},
                "contract": {"$ref": "#/$defs/semver"},
                "renderer": {"$ref": "#/$defs/semver"}
            }
        },
        "semantic_fingerprints": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "formula"],
            "properties": {
                "source": {"$ref": "#/$defs/sha256"},
                "formula": {"$ref": "#/$defs/sha256"}
            }
        },
        "fixture_sha256": {"$ref": "#/$defs/sha256"},
        "conformance_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["snapshot_kind", "snapshot_id", "source_sha256", "rows_sha256", "row_count", "assertion_codes"],
            "properties": {
                "snapshot_kind": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,63}$"},
                "snapshot_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
                "source_sha256": {"$ref": "#/$defs/sha256"},
                "rows_sha256": {"$ref": "#/$defs/sha256"},
                "row_count": {"type": "integer", "minimum": 0},
                "assertion_codes": {"$ref": "#/$defs/sourceAssertions"}
            }
        },
        "formula": {
            "type": "object",
            "additionalProperties": false,
            "required": ["formula_version", "totals_sha256", "assertion_codes"],
            "properties": {
                "formula_version": {"$ref": "#/$defs/semver"},
                "totals_sha256": {"$ref": "#/$defs/sha256"},
                "assertion_codes": {"$ref": "#/$defs/formulaAssertions"}
            }
        },
        "components": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["class", "sha256"],
                "properties": {
                    "class": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_\\\\]{0,255}$"},
                    "sha256": {"$ref": "#/$defs/sha256"}
                }
            }
        },
        "permissions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["view", "run", "export", "download", "sensitive", "audit"],
            "properties": {
                "view": {"$ref": "#/$defs/requiredPermissions"},
                "run": {"$ref": "#/$defs/requiredPermissions"},
                "export": {"$ref": "#/$defs/requiredPermissions"},
                "download": {"$ref": "#/$defs/requiredPermissions"},
                "sensitive": {"$ref": "#/$defs/permissions"},
                "audit": {"$ref": "#/$defs/permissions"}
            }
        },
        "export_contracts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["format", "schema_sha256", "fixture_sha256", "renderer_sha256", "assertion_codes"],
                "properties": {
                    "format": {"enum": ["csv", "pdf", "xlsx"]},
                    "schema_sha256": {"$ref": "#/$defs/sha256"},
                    "fixture_sha256": {"$ref": "#/$defs/sha256"},
                    "renderer_sha256": {"$ref": "#/$defs/sha256"},
                    "assertion_codes": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {"type": "string", "pattern": "^export\\.(csv|pdf|xlsx)\\.[a-z][a-z0-9_]*\\.passed$"}
                    }
                },
                "allOf": [
                    {
                        "if": {"properties": {"format": {"const": "csv"}}, "required": ["format"]},
                        "then": {"properties": {"assertion_codes": {"items": {"pattern": "^export\\.csv\\.[a-z][a-z0-9_]*\\.passed$"}}}}
                    },
                    {
                        "if": {"properties": {"format": {"const": "pdf"}}, "required": ["format"]},
                        "then": {"properties": {"assertion_codes": {"items": {"pattern": "^export\\.pdf\\.[a-z][a-z0-9_]*\\.passed$"}}}}
                    },
                    {
                        "if": {"properties": {"format": {"const": "xlsx"}}, "required": ["format"]},
                        "then": {"properties": {"assertion_codes": {"items": {"pattern": "^export\\.xlsx\\.[a-z][a-z0-9_]*\\.passed$"}}}}
                    }
                ]
            }
        },
        "drill_down_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema_sha256", "assertion_codes"],
            "properties": {
                "schema_sha256": {"$ref": "#/$defs/sha256"},
                "assertion_codes": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"type": "string", "pattern": "^drill_down\\.[a-z][a-z0-9_]*\\.passed$"}
                }
            }
        },
        "ci": {
            "type": "object",
            "additionalProperties": false,
            "required": ["run_id", "commit_sha", "suite_sha256", "completed_at_utc", "required_checks"],
            "properties": {
                "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
                "commit_sha": {"$ref": "#/$defs/gitSha"},
                "suite_sha256": {"$ref": "#/$defs/sha256"},
                "completed_at_utc": {"$ref": "#/$defs/utcMicroseconds"},
                "required_checks": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}
                }
            }
        },
        "release": {
            "type": "object",
            "additionalProperties": false,
            "required": ["git_sha", "created_at_utc", "approver_identity"],
            "properties": {
                "git_sha": {"$ref": "#/$defs/gitSha"},
                "created_at_utc": {"$ref": "#/$defs/utcMicroseconds"},
                "approver_identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9@._:-]{2,127}$"}
            }
        }
    },
    "$defs": {
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "gitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "reportCode": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "utcMicroseconds": {"type": "string", "pattern": "^(19|20)[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$"},
        "permissions": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$", "not": {"pattern": "(^|[._-])manage$"}}
        },
        "requiredPermissions": {
            "allOf": [
                {"$ref": "#/$defs/permissions"},
                {"minItems": 1}
            ]
        },
        "sourceAssertions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^source\\.[a-z][a-z0-9_]*\\.passed$"}
        },
        "formulaAssertions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^formula\\.[a-z][a-z0-9_]*\\.passed$"}
        }
    }
}
