{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"urn:most:reporting:report-catalog-activation:v1", "type":"object", "additionalProperties":false,
  "required":["artifact_id","schema_version","status","release_sha","previous_manifest_sha256","published_manifest_sha256","published_codes","binding_codes","publication_lock_hashes","conformance_hashes","activated_at"],
  "properties":{"artifact_id":{"const":"report_catalog_activation"},"schema_version":{"const":"1.0.0"},"status":{"const":"catalog_activated"},"release_sha":{"$ref":"#/$defs/sha1"},"previous_manifest_sha256":{"$ref":"#/$defs/sha256"},"published_manifest_sha256":{"$ref":"#/$defs/sha256"},"published_codes":{"$ref":"#/$defs/codes"},"binding_codes":{"$ref":"#/$defs/codes"},"publication_lock_hashes":{"$ref":"#/$defs/hashes"},"conformance_hashes":{"$ref":"#/$defs/hashes"},"activated_at":{"$ref":"#/$defs/timestamp"}},
  "$defs":{"sha1":{"type":"string","pattern":"^[a-f0-9]{40}$"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"timestamp":{"type":"string","format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},"codes":{"type":"array","minItems":28,"maxItems":28,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_]{2,63}$"}},"hashes":{"type":"array","minItems":28,"maxItems":28,"uniqueItems":true,"items":{"$ref":"#/$defs/sha256"}}}
}
