{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:most:reporting:r15-candidate-manifest:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["admission_status", "code", "contract_version", "formula_version", "generated_from_commit", "publication_status", "runtime_binding", "source_schema_version"],
  "properties": {
    "admission_status": {"const": "candidate"},
    "code": {"const": "procurement_cycle"},
    "contract_version": {"const": "1.0.0"},
    "formula_version": {"const": "procurement-cycle.v1"},
    "generated_from_commit": {"$ref": "#/$defs/sha1"},
    "publication_status": {"const": "blocked"},
    "runtime_binding": {"$ref": "#/$defs/runtimeBinding"},
    "source_schema_version": {"const": "1.0.0"}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "runtimeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "sha256"],
      "properties": {
        "class": {"const": "App\\BusinessModules\\Features\\Procurement\\Reporting\\Cycle\\Services\\ProcurementCycleReportBindingFactory"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
