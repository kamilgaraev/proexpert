{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:most:reporting:report-conformance-evidence:v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "assertion_count",
        "code",
        "commit_sha",
        "component_class_hashes",
        "contract_version",
        "definition_hash",
        "digest",
        "fixture_hash",
        "formula",
        "generated_at",
        "source",
        "source_schema_version",
        "status"
    ],
    "properties": {
        "assertion_count": {
            "type": "integer",
            "minimum": 1
        },
        "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "commit_sha": {
            "$ref": "#/$defs/sha1"
        },
        "component_class_hashes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "$ref": "#/$defs/componentClassHash"
            }
        },
        "contract_version": {
            "$ref": "#/$defs/nonEmpty"
        },
        "definition_hash": {
            "$ref": "#/$defs/sha256"
        },
        "digest": {
            "$ref": "#/$defs/sha256"
        },
        "fixture_hash": {
            "$ref": "#/$defs/sha256"
        },
        "formula": {
            "$ref": "#/$defs/formulaEvidence"
        },
        "generated_at": {
            "$ref": "#/$defs/timestamp"
        },
        "source": {
            "$ref": "#/$defs/sourceEvidence"
        },
        "source_schema_version": {
            "$ref": "#/$defs/nonEmpty"
        },
        "status": {
            "enum": [
                "passed",
                "failed"
            ]
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "status": {
                        "const": "passed"
                    }
                },
                "required": [
                    "status"
                ]
            },
            "then": {
                "properties": {
                    "formula": {
                        "properties": {
                            "passed": {
                                "const": true
                            }
                        },
                        "required": [
                            "passed"
                        ]
                    },
                    "source": {
                        "properties": {
                            "passed": {
                                "const": true
                            }
                        },
                        "required": [
                            "passed"
                        ]
                    }
                }
            },
            "else": {
                "anyOf": [
                    {
                        "properties": {
                            "formula": {
                                "properties": {
                                    "passed": {
                                        "const": false
                                    }
                                },
                                "required": [
                                    "passed"
                                ]
                            }
                        }
                    },
                    {
                        "properties": {
                            "source": {
                                "properties": {
                                    "passed": {
                                        "const": false
                                    }
                                },
                                "required": [
                                    "passed"
                                ]
                            }
                        }
                    }
                ]
            }
        }
    ],
    "$defs": {
        "formulaAssertionCode": {
            "type": "string",
            "pattern": "^formula\\.[a-z][a-z0-9_]*\\.(?:passed|failed)$"
        },
        "componentClassHash": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "class",
                "sha256"
            ],
            "properties": {
                "class": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_\\\\]{0,255}$"
                },
                "sha256": {
                    "$ref": "#/$defs/sha256"
                }
            }
        },
        "formulaEvidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "assertion_codes",
                "formula_version",
                "passed",
                "totals_hash"
            ],
            "properties": {
                "assertion_codes": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/formulaAssertionCode"
                    }
                },
                "formula_version": {
                    "$ref": "#/$defs/nonEmpty"
                },
                "passed": {
                    "type": "boolean"
                },
                "totals_hash": {
                    "$ref": "#/$defs/sha256"
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "passed": {
                                "const": true
                            }
                        },
                        "required": [
                            "passed"
                        ]
                    },
                    "then": {
                        "properties": {
                            "assertion_codes": {
                                "items": {
                                    "pattern": "^formula\\.[a-z][a-z0-9_]*\\.passed$"
                                }
                            }
                        }
                    },
                    "else": {
                        "properties": {
                            "assertion_codes": {
                                "contains": {
                                    "pattern": "^formula\\.[a-z][a-z0-9_]*\\.failed$"
                                },
                                "minContains": 1
                            }
                        }
                    }
                }
            ]
        },
        "nonEmpty": {
            "type": "string",
            "pattern": "^\\S(?:.*\\S)?$"
        },
        "sha1": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
        },
        "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        },
        "sourceEvidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "assertion_codes",
                "passed",
                "row_count",
                "rows_hash",
                "snapshot_id",
                "snapshot_kind",
                "source_hash"
            ],
            "properties": {
                "assertion_codes": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/sourceAssertionCode"
                    }
                },
                "passed": {
                    "type": "boolean"
                },
                "row_count": {
                    "type": "integer",
                    "minimum": 0
                },
                "rows_hash": {
                    "$ref": "#/$defs/sha256"
                },
                "snapshot_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "snapshot_kind": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.:-]{0,63}$"
                },
                "source_hash": {
                    "$ref": "#/$defs/sha256"
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "passed": {
                                "const": true
                            }
                        },
                        "required": [
                            "passed"
                        ]
                    },
                    "then": {
                        "properties": {
                            "assertion_codes": {
                                "items": {
                                    "pattern": "^source\\.[a-z][a-z0-9_]*\\.passed$"
                                }
                            }
                        }
                    },
                    "else": {
                        "properties": {
                            "assertion_codes": {
                                "contains": {
                                    "pattern": "^source\\.[a-z][a-z0-9_]*\\.failed$"
                                },
                                "minContains": 1
                            }
                        }
                    }
                }
            ]
        },
        "sourceAssertionCode": {
            "type": "string",
            "pattern": "^source\\.[a-z][a-z0-9_]*\\.(?:passed|failed)$"
        },
        "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
        }
    }
}
