{
    "name": "Отчеты",
    "slug": "reports",
    "version": "2.0.0",
    "type": "core",
    "billing_model": "free",
    "category": "analytics",
    "description": "Унифицированный модуль отчетности, включающий базовые отчеты и расширенную аналитику.",
    "class_name": "App\\BusinessModules\\Core\\Reporting\\ReportingModule",
    "service_provider": "App\\BusinessModules\\Core\\Reporting\\ReportingContractsServiceProvider",
    "auto_activate": true,
    "is_system_module": true,
    "can_deactivate": false,
    "pricing": {
        "base_price": 0,
        "currency": "RUB",
        "duration_days": 30
    },
    "permissions": [
        "reports.view",
        "reports.run",
        "reports.export",
        "reports.download",
        "reports.manage",
        "reports.sensitive",
        "reports.audit",
        "reports.project_readiness.view",
        "reports.project_readiness.export"
    ],
    "features": [
        "Базовые отчеты (материалы, работы, проекты)",
        "Финансовая аналитика и KPI",
        "Генерация официальных форм (М-29 и др.)",
        "Прогнозирование и ML-аналитика"
    ],
    "dependencies": [
        "organizations",
        "users",
        "project-management"
    ],
    "conflicts": [],
    "limits": {},
    "routes": [
        "app/BusinessModules/Core/Reporting/routes.php"
    ],
    "settings": [
        {
            "key": "default_export_format",
            "type": "select",
            "options": [
                "pdf",
                "xlsx",
                "csv"
            ],
            "default": "pdf"
        }
    ]
}
